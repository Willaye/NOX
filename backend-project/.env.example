# ╔══════════════════════════════════════════════════════════════════════╗
# ║                    NOX MDM — Configuration                         ║
# ║                                                                    ║
# ║  Copy this file to .env and fill in your values:                   ║
# ║  cp .env.example .env                                              ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ─── Server ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Comma-separated allowed origins for the admin dashboard
CORS_ORIGINS=https://your-dashboard-domain.com

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nox?schema=public"
POSTGRES_USER=noxuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=nox

# ─── Authentication ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# ─── Email (SMTP) ───────────────────────────────────────────────────────
# NOX sends verification emails and device alerts.
# You need SMTP credentials from ANY email provider.
#
# ┌─────────────────────────────────────────────────────────────────────┐
# │ FREE OPTIONS (no credit card needed):                              │
# │                                                                    │
# │ 1. Brevo (recommended) — 300 emails/day free                      │
# │    Sign up: https://onboarding.brevo.com/account/register          │
# │    SMTP key: https://app.brevo.com/settings/keys/smtp              │
# │    SMTP_HOST=smtp-relay.brevo.com                                  │
# │    SMTP_PORT=587                                                   │
# │    SMTP_USER=your-brevo-email@company.com                         │
# │    SMTP_PASS=xkeysib-your-api-key                                 │
# │                                                                    │
# │ 2. Gmail (needs App Password + 2FA)                               │
# │    SMTP_HOST=smtp.gmail.com                                        │
# │    SMTP_PORT=587                                                   │
# │    SMTP_USER=your-email@gmail.com                                 │
# │    SMTP_PASS=your-16-char-app-password                            │
# │                                                                    │
# │ 3. Outlook/Office365                                               │
# │    SMTP_HOST=smtp.office365.com                                    │
# │    SMTP_PORT=587                                                   │
# │    SMTP_USER=your-email@outlook.com                               │
# │    SMTP_PASS=your-password                                        │
# │                                                                    │
# │ 4. AWS SES (62,000 emails/month free)                             │
# │    SMTP_HOST=email-smtp.us-east-1.amazonaws.com                   │
# │    SMTP_PORT=587                                                   │
# │    SMTP_USER=your-ses-smtp-user                                   │
# │    SMTP_PASS=your-ses-smtp-password                               │
# └─────────────────────────────────────────────────────────────────────┘
#
# If left empty, emails are logged to console (development mode only).

# ⚠️ IMPORTANT FOR RAILWAY / CLOUD HOSTS:
# Railway (Hobby/Trial) BLOCKS outbound SMTP ports (25/465/587). Plain SMTP
# (Gmail, Outlook, etc.) will TIME OUT in production. Use the Brevo HTTP API
# below instead — it sends over HTTPS/443, which is always allowed. When
# BREVO_API_KEY is set, NOX uses it and ignores SMTP.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Display name for outgoing emails (e.g., "NOX <noreply@company.com>")
SMTP_FROM=NOX <noreply@company.com>

# ─── Brevo transactional email HTTP API (RECOMMENDED on Railway) ─────────
# Free: 300 emails/day, no domain required (just verify a sender address).
#   1. Sign up:        https://www.brevo.com   (choose the free plan)
#   2. Verify sender:  https://app.brevo.com/senders  (add the SMTP_FROM email)
#   3. Create API key: https://app.brevo.com/settings/keys/api
# Paste the key (starts with "xkeysib-"). Leave empty to fall back to SMTP.
BREVO_API_KEY=

# ─── App URL ────────────────────────────────────────────────────────────
# Used in email links and the /enroll/i/:token landing page. In production
# this must be the public base URL where the backend is reachable from the
# employee's phone (not localhost).
APP_URL=https://your-domain.com

# ─── Enrollment ─────────────────────────────────────────────────────────
# Directory where /enroll/apk/:token streams the signed APK from. Must be
# readable by the Node process. If the file nox-agent.apk is missing, the
# endpoint returns 404 — drop the signed build there to activate.
APK_DIR=./apk

# ─── Uploads ────────────────────────────────────────────────────────────
# Where device-uploaded gallery media is stored on disk. Admin downloads
# stream back from here.
UPLOADS_DIR=./uploads

# ─── Offline watcher ────────────────────────────────────────────────────
# How long a device can be silent before the cron marks it offline (ms).
# Keep > heartbeat_interval × 3 so brief network blips don't alert.
OFFLINE_THRESHOLD_MS=180000

# ─── Firebase Cloud Messaging (push to admin app) ───────────────────────
# Pick ONE of the two forms. If neither is set, pushes are silently skipped
# (dev mode). Service account JSON must have `messaging.send` IAM.
#
# Inline (easiest for dev / env-based deploys):
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# Path form (easier for prod container mounts):
#   FIREBASE_SERVICE_ACCOUNT_PATH=/etc/nox/firebase.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# When true (and NODE_ENV != production), /auth/magic-link/request returns the
# token in the JSON response for local testing. Keep this UNSET in production.
DEV_EXPOSE_MAGIC_TOKEN=false
