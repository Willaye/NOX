# Database data (Docker volume)
postgres-data/

# Enrollment / media storage (served by the backend at runtime).
# APKs are too large for git but MUST ship to Railway. .railwayignore has
# matching negation rules so `railway up` uploads them. Developers should
# NOT run `git add apk/*.apk` — those files are deliberately untracked.
/apk/*
!/apk/.gitkeep
!/apk/manifest.json
!/apk/nox-agent.apk
!/apk/nox-admin.apk
/uploads/
