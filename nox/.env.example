# =============================================================================
# NOX environment configuration
# Copy to .env (`cp .env.example .env`) and replace every `change-me` value.
# .env is git-ignored; never commit real secrets.
#
# Used by:
#   - nox/backend (ConfigModule loads ../.env relative to backend/)
#   - infrastructure/docker/docker-compose.yml
#       (run with: docker compose --env-file ../../.env up -d)
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# HTTP API port (routes are served under /api)
PORT=3000
# WebSocket gateway port
WS_PORT=3001
# Comma-separated list of allowed browser origins (no spaces)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# Reported by GET /api/health
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Used by docker-compose to initialise the Postgres container.
POSTGRES_USER=nox_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=nox_db
# Host port mapped to the container's 5432 (5433 avoids a local Postgres)
POSTGRES_HOST_PORT=5433
# Prisma connection string for running the backend on the host.
# Must match the POSTGRES_* values above. (In Docker, compose overrides this
# to point at postgres:5432.)
DATABASE_URL=postgresql://nox_user:change-me-postgres-password@localhost:5433/nox_db?schema=public

# -----------------------------------------------------------------------------
# Redis (sessions / caching)
# -----------------------------------------------------------------------------
# Host-side URL; compose overrides to redis://redis:6379 inside Docker.
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 48   (min 32 chars, use different values)
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# Access-token lifetime (vercel/ms format: 15m, 1h, 7d)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-refresh-secret-at-least-32-characters
REFRESH_TOKEN_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# S3-compatible storage (MinIO locally)
# -----------------------------------------------------------------------------
# Host-side endpoint; compose overrides to http://minio:9000 inside Docker.
S3_ENDPOINT=http://localhost:9000
# Also used as the MinIO root user/password by docker-compose.
# MinIO requires: access key >= 3 chars, secret key >= 8 chars.
S3_ACCESS_KEY=nox_minio
S3_SECRET_KEY=change-me-minio-secret
# Bucket is created automatically by the minio-init compose service
S3_BUCKET=nox-files
S3_REGION=us-east-1
# Host ports for MinIO S3 API and web console
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
# 587 = STARTTLS, 465 = implicit TLS
SMTP_PORT=587
SMTP_USER=nox@example.com
SMTP_PASS=change-me-smtp-password

# -----------------------------------------------------------------------------
# Push notifications (Firebase Cloud Messaging)
# -----------------------------------------------------------------------------
FCM_SERVER_KEY=change-me-fcm-server-key

# -----------------------------------------------------------------------------
# WebRTC STUN/TURN
# -----------------------------------------------------------------------------
# Public STUN server is fine for development
STUN_URL=stun:stun.l.google.com:19302
# Optional TURN relay (needed behind symmetric NAT). Leave empty to disable.
# Example: turn:turn.example.com:3478
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
